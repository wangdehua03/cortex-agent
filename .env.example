# Cortex Agent 运行配置示例
# 复制本文件为 .env 并填写你的实际值，或在启动前通过 export 注入环境变量。
# 注意：.env 文件已被 .gitignore 忽略，不会误提交到仓库。

# ============================================================
# LLM 连接配置（必填）
# ------------------------------------------------------------
# 本平台支持任意 OpenAI 兼容 API，包括第三方云端服务和本地部署服务。
#
# 第三方 API 示例：
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_BASE_URL=https://api.deepseek.com/v1
#
# 本地部署示例（vLLM / Ollama / xinference 等）：
#   LLM_BASE_URL=http://localhost:8000/v1
#   LLM_BASE_URL=http://localhost:11434/v1
# ============================================================
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=kimi-for-coding

# 可选：覆盖默认温度与上下文窗口
# LLM_TEMPERATURE=1.0
# LLM_CONTEXT_WINDOW=262144

# 可选：本地 tokenizer 路径，留空则使用 tiktoken 近似估算
# TOKENIZER_PATH=/path/to/local/tokenizer
